# =============================================================================
# ЗРАЗОК КОНФІГУ. Скопіювати в .env і заповнити реальними значеннями.
# =============================================================================
#
# ⚠️ У ЦЬОМУ ФАЙЛІ НЕ МАЄ БУТИ ЖОДНОГО СПРАВЖНЬОГО СЕКРЕТУ.
#
# Раніше він був побайтовою копією .env — з бойовими ключами monobank,
# паролем бази й SECRET_KEY. А .gitignore його явно дозволяє (`!.env.example`),
# тож секрети потрапляли в репозиторій навіть після `git rm --cached .env`.
#
# Перед тим як вписувати нові ключі, зроби:
#     git rm --cached backend/.env
#     git commit -m "прибрати .env з індексу"
# і ПРОВЕРНИ старі секрети: вони назавжди лишаються в історії git.

# --- середовище ---------------------------------------------------------------
APP_ENV=production
DEBUG_SQL=false
AUTO_CREATE_TABLES=false

# Довільний довгий випадковий рядок. Згенерувати:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Використовується для підпису сесій адмінки Й для хешування візитів
# у лічильнику — після зміни статистика відвідувачів почне рахуватися наново.
SECRET_KEY=

COOKIE_NAME=admin_session

# Публічна адреса сайту. З неї збираються адреси колбеків платіжних систем.
SITE_URL=https://my-prime-academy.com

# --- база ---------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=school_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db:5432/school_db

ALLOWED_ORIGINS=https://my-prime-academy.com,https://www.my-prime-academy.com

# --- адмін за замовчуванням ---------------------------------------------------
# Створюється при першому старті, якщо такого ще немає.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================================
# ОПЛАТИ
# =============================================================================
#
# ГОЛОВНИЙ ЗАПОБІЖНИК. Поки false — сайт не приймає гроші взагалі,
# а сторінка оформлення чесно пропонує оформити вручну.
# Вмикати ТІЛЬКИ після того, як:
#   1) у frontend/src/lib/legal/seller.js вписані реквізити ФОПа
#   2) Покупка Частинами прогнана в пісочниці наскрізь
#   3) отримано бойовий токен plata
PAYMENTS_ENABLED=false

# --- Покупка Частинами monobank | Universal Bank -------------------------------
# Беруться в бізнес-кабінеті monobank, розділ «Покупка Частинами».
# Тобі вони вже видані.
MONO_CHAST_STORE_ID=
MONO_CHAST_SIGN_KEY=

# Пісочниця (відкрита без узгоджень, безпечна для тестів):
#     MONO_CHAST_BASE_URL=https://u2-demo-ext.mono.st4g3.com
#     MONO_CHAST_STORE_ID=test_store_with_confirm
#     MONO_CHAST_SIGN_KEY=secret_98765432--123-123
MONO_CHAST_BASE_URL=https://u2-demo-ext.mono.st4g3.com

# Мінімальна кількість платежів. Правило monobank: якщо маржі не вистачає,
# підіймати цю межу або вимикати ПЧ для товару — але НЕ націнювати ціну.
MONO_CHAST_MIN_PARTS=3

# --- plata by mono (звичайний картковий еквайринг) ------------------------------
# Токен береться в бізнес-кабінеті monobank: Розробникам → plata by mono → API-токен.
# Це ІНШИЙ продукт і ІНШИЙ ключ, не той, що для Покупки Частинами.
MONO_PLATA_TOKEN=
MONO_PLATA_BASE_URL=https://api.monobank.ua
